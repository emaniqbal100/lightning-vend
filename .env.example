# Leave OPENNODE_API_KEY empty to run in MOCK mode (no real payments).
OPENNODE_API_KEY=
# "dev" uses OpenNode testnet (dev-api.opennode.com), "live" uses real bitcoin.
OPENNODE_ENV=dev
PAYMENT_AMOUNT=1.50
PAYMENT_CURRENCY=USD
# Optional: public URL of this server so OpenNode can call the webhook. Polling works without it.
PUBLIC_URL=
# Where to tell the vending machine about credit. Adapt to the CryptoVend tablet API
# (see https://github.com/iozeta/cryptovend-tablet-ui). Leave empty to only log.
CRYPTOVEND_URL=
PORT=3000
