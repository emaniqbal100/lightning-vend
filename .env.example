# ── Lightning Vend configuration ───────────────────────────────────────────
# Copy to .env and edit. Validation happens at startup with clear errors.

# ── General ──
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# SQLite database file path.
DB_PATH=./data/lightning-vend.db

# ── Payment provider ──
# mock | opennode | lnbits | btcpay (lnbits/btcpay are documented stubs)
PROVIDER=mock
OPENNODE_API_KEY=
OPENNODE_ENV=dev
# Public base URL of this server (https) so OpenNode can reach the webhook.
PUBLIC_URL=

# ── Vending machine ──
# mock | cryptovend
MACHINE=mock
# CryptoVend: local device URL. Verified protocol: POST {base}/add/pay with
# form body amt=<fiat> + HTTP Basic Auth. See docs/limitations.md (unverified).
CRYPTOVEND_BASE_URL=
CRYPTOVEND_USER=
CRYPTOVEND_PASS=
CRYPTOVEND_REQUEST_TIMEOUT_MS=5000

# ── Kiosk ──
KIOSK_DEFAULT_LANGUAGE=en
POLL_INTERVAL_MS=2000
# Mock fiat→sats rate (sats per 1 unit of fiat) shown in mock mode.
BTC_EXCHANGE_RATE=15000
DEFAULT_PRICE=1.50
DEFAULT_CURRENCY=USD
INVOICE_EXPIRY_SECONDS=600

# ── Credit idempotency / retry ──
CREDIT_MAX_ATTEMPTS=5
CREDIT_INITIAL_BACKOFF_MS=1000
CREDIT_MAX_BACKOFF_MS=30000
CREDIT_STALE_CLAIM_MS=60000

# ── Mock provider ──
MOCK_PAY_DELAY_MS=4000

# ── Webhook replay protection ──
WEBHOOK_REPLAY_TTL_MS=3600000

# ── HTTP hardening ──
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
# Comma-separated allowed origins, e.g. https://kiosk.example.com
CORS_ALLOWED_ORIGINS=
BODY_LIMIT=8192

# ── Admin auth ──
ADMIN_USERNAME=admin
# Set ONE of the following. ADMIN_PASSWORD is plaintext (dev only).
# Generate a hash:  node -e "const c=require('crypto');const p=process.argv[1];const s=c.randomBytes(16);const h=c.scryptSync(p,s,64).toString('hex');console.log(s.toString('hex')+':'+h)" 'yourpassword'
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
# Optional: stable across restarts. If omitted, a random one is generated
# (sessions then reset on every restart).
SESSION_SECRET=
SESSION_TTL_MS=86400000

# ── Alerts (optional) ──
ALERT_WEBHOOK_URL=
ALERT_EMAIL_TO=
