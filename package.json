{"name": "lightning-vend", "version": "2.0.0", "private": true, "description": "Production-grade Bitcoin Lightning payment kiosk for vending machines (OpenNode + CryptoVend)", "license": "MIT", "type": "module", "engines": {"node": ">=20"}, "workspaces": ["shared", "server", "kiosk", "admin"], "scripts": {"build": "npm run typecheck && npm run -w kiosk build && npm run -w admin build", "dev": "concurrently -n server,kiosk,admin -c blue,magenta,green \"npm:dev:server\" \"npm:dev:kiosk\" \"npm:dev:admin\"", "dev:server": "npm run -w server dev", "dev:kiosk": "npm run -w kiosk dev", "dev:admin": "npm run -w admin dev", "start": "npm run -w server start", "typecheck": "npm run -w shared typecheck && npm run -w server typecheck && npm run -w kiosk typecheck && npm run -w admin typecheck", "lint": "eslint .", "format": "prettier --write .", "test": "vitest run", "test:watch": "vitest", "test:e2e": "npm run -w e2e test --if-present", "coverage": "vitest run --coverage"}, "devDependencies": {"@types/node": "^22.7.0", "@typescript-eslint/eslint-plugin": "^8.8.0", "@typescript-eslint/parser": "^8.8.0", "concurrently": "^9.0.1", "eslint": "^9.11.0", "eslint-config-prettier": "^9.1.0", "globals": "^15.9.0", "prettier": "^3.3.3", "typescript": "^5.6.2", "vitest": "^2.1.0"}}